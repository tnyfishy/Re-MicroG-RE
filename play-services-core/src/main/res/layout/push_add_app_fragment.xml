<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/push_add_app_swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/push_add_app_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Material 3 loading indicator in a round container, shown while the list loads or is pulled to reload -->
    <FrameLayout
        android:id="@+id/push_add_app_loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/loading_indicator_container"
        android:elevation="6dp"
        android:visibility="gone">

        <com.google.android.material.loadingindicator.LoadingIndicator
            style="@style/Widget.Material3.LoadingIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>
