<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="prefcat_networks"
        android:layout="@layout/preference_material_category"
        android:title="@string/pref_gcm_ping_category"
        app:allowDividerAbove="false">

        <!-- One interval for every network: Wi-Fi, mobile data, roaming and others -->
        <Preference
            android:icon="@drawable/ic_network_wifi"
            android:key="pref_gcm_ping_interval"
            android:layout="@layout/preference_material_single"
            android:persistent="false"
            android:title="@string/pref_gcm_ping_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_material_category"
        android:title="@string/prefcat_advanced"
        app:allowDividerAbove="false">

        <Preference
            android:key="pref_remove_all_registers"
            android:layout="@layout/preference_material_single"
            android:summary="@string/pref_gcm_remove_registers_summary"
            android:title="@string/pref_gcm_remove_registers"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
